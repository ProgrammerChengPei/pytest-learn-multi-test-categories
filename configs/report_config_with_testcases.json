{
  "template": "templates/test_report_template.xlsx",
  "output_dir": "reports",
  "mappings": {
    "测试汇总 / Summary": {
      "type": "summary",
      "fields": {
        "报告生成时间 / Report Time": {
          "cell": "C3",
          "source": "session.report_time",
          "format": "datetime"
        },
        "测试总耗时 / Total Duration": {
          "cell": "C4",
          "source": "session.total_duration",
          "format": "number",
          "decimals": 2,
          "unit": " 秒"
        },
        "测试总数 / Total Tests": {
          "cell": "C5",
          "source": "stats.total",
          "format": "number"
        },
        "通过数 / Passed": {
          "cell": "C6",
          "source": "stats.passed",
          "format": "number"
        },
        "失败数 / Failed": {
          "cell": "C7",
          "source": "stats.failed",
          "format": "number"
        },
        "跳过数 / Skipped": {
          "cell": "C8",
          "source": "stats.skipped",
          "format": "number"
        }
      },
      "type_stats": {
        "start_row": 12,
        "columns": {
          "测试类型 / Type": "A",
          "总数 / Total": "B",
          "通过 / Passed": "C",
          "失败 / Failed": "D",
          "通过率 / Pass Rate": "E"
        },
        "row_mapping": {
          "flash": 12,
          "interface": 13,
          "function": 14,
          "performance": 15
        },
        "fields": {
          "刷写 / Flash": {
            "total": {
              "source": "stats.flash.total",
              "format": "number"
            },
            "passed": {
              "source": "stats.flash.passed",
              "format": "number"
            },
            "failed": {
              "source": "stats.flash.failed",
              "format": "number"
            },
            "pass_rate": {
              "source": "stats.flash.pass_rate",
              "format": "percent"
            }
          },
          "接口 / Interface": {
            "total": {
              "source": "stats.interface.total",
              "format": "number"
            },
            "passed": {
              "source": "stats.interface.passed",
              "format": "number"
            },
            "failed": {
              "source": "stats.interface.failed",
              "format": "number"
            },
            "pass_rate": {
              "source": "stats.interface.pass_rate",
              "format": "percent"
            }
          },
          "功能 / Function": {
            "total": {
              "source": "stats.function.total",
              "format": "number"
            },
            "passed": {
              "source": "stats.function.passed",
              "format": "number"
            },
            "failed": {
              "source": "stats.function.failed",
              "format": "number"
            },
            "pass_rate": {
              "source": "stats.function.pass_rate",
              "format": "percent"
            }
          },
          "性能 / Performance": {
            "total": {
              "source": "stats.performance.total",
              "format": "number"
            },
            "passed": {
              "source": "stats.performance.passed",
              "format": "number"
            },
            "failed": {
              "source": "stats.performance.failed",
              "format": "number"
            },
            "pass_rate": {
              "source": "stats.performance.pass_rate",
              "format": "percent"
            }
          }
        }
      }
    },
    "测试详情 / Test Details": {
      "type": "list",
      "start_row": 2,
      "columns": {
        "序号 / No": {
          "col": "A",
          "source": "index",
          "format": "number"
        },
        "测试名称 / Test Name": {
          "col": "B",
          "source": "name",
          "format": "string"
        },
        "测试类型 / Test Type": {
          "col": "C",
          "source": "category",
          "format": "string"
        },
        "状态 / Status": {
          "col": "D",
          "source": "status",
          "format": "string",
          "style": {
            "passed": {
              "fill": "C6EFCE"
            },
            "failed": {
              "fill": "FFC7CE"
            },
            "skipped": {
              "fill": "FFEB9C"
            }
          }
        },
        "耗时 / Duration (s)": {
          "col": "E",
          "source": "duration",
          "format": "number",
          "decimals": 3
        },
        "文件 / File": {
          "col": "F",
          "source": "file",
          "format": "string"
        },
        "行号 / Line": {
          "col": "G",
          "source": "line",
          "format": "number"
        },
        "消息 / Message": {
          "col": "H",
          "source": "message",
          "format": "string"
        },
        "性能指标 / Metric": {
          "col": "I",
          "source": "metric",
          "format": "string"
        },
        "指标值 / Metric Value": {
          "col": "J",
          "source": "value",
          "format": "string"
        }
      }
    },
    "测试用例 / Test Cases": {
      "type": "testcase_mapping",
      "name_column": "B",
      "result_column": "J",
      "result_mappings": {
        "passed": "通过",
        "failed": "失败",
        "skipped": "跳过"
      }
    }
  }
}
